# Copy to .env and fill in every value. Never commit .env.
# Generate SESSION_SECRET with: openssl rand -hex 32

# --- Postgres (used by docker-compose.yml) ---
POSTGRES_DB=mfe_db
POSTGRES_USER=mfe_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# --- Prisma / app ---
DATABASE_URL=postgresql://mfe_user:CHANGE_ME_strong_password@localhost:5432/mfe_db

# Optional isolated database/schema used by database-backed integration and E2E tests.
# Never point this at production.
# TEST_DATABASE_URL=postgresql://mfe_user:CHANGE_ME_strong_password@localhost:5432/mfe_test

# Session signing secret - must be random and at least 32 chars.
# If this stays as the placeholder the app will refuse to start in production.
SESSION_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# Session cookie name (optional)
# SESSION_COOKIE_NAME=mfe_session

# Session lifetime in days (optional, default 7)
# SESSION_TTL_DAYS=7

# --- Cookie security ---
# Controls the Secure flag on session and OAuth cookies.
#   true  -> always Secure (required for any HTTPS deployment, including
#            behind a TLS-terminating proxy like Cloudflare Tunnel)
#   false -> never Secure (local HTTP development only)
#   unset -> Secure iff NODE_ENV=production
# Always set true in production. Relying on NODE_ENV alone is fragile in
# self-hosted Docker setups that may forget to set it.
COOKIE_SECURE=true

# --- File uploads ---
# Absolute path on the server. Defaults to <cwd>/uploads when unset.
# UPLOAD_DIR=/var/data/mfe/uploads
# MAX_UPLOAD_MB=10

# --- OCR ---
# Set to "tesseract" for production. "mock" returns dummy data and must NOT be
# used in production.
OCR_PROVIDER=tesseract

# --- Rate limiting ---
# Set to "true" ONLY when the app runs exclusively behind Cloudflare Tunnel or a
# trusted reverse proxy that sets cf-connecting-ip or x-forwarded-for.
# Leave false if the port is also directly reachable - headers can be spoofed.
TRUST_PROXY_HEADERS=false

# --- Household bootstrap ---
# Set to "true" only during initial deployment of brand-new users (no existing DB data).
# After running the backfill script for existing data, set back to false.
# Default false prevents login from silently creating empty households that would
# break the backfill workflow.
ALLOW_LOGIN_HOUSEHOLD_BOOTSTRAP=false

# --- Signup verification + password reset email ---
# Public password signup requires email verification AND the forgot-password
# flow requires SMTP delivery. In production, configure SMTP before allowing
# users to register or request password resets — both routes fail closed
# without SMTP when NODE_ENV=production.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASSWORD=
SMTP_FROM=noreply@your-app.example.com

# --- Dev-only verification + reset links ---
# When DEV_SHOW_VERIFICATION_LINKS=true AND NODE_ENV is not "production", the
# signup API response returns the email verification URL and the
# forgot-password API response returns the password reset URL so local devs
# can finish the flows without SMTP. In production this flag is IGNORED and
# both routes always fail closed when SMTP is not configured. Reset URLs are
# never logged in production.
DEV_SHOW_VERIFICATION_LINKS=false

# --- Public app URL ---
# Used as the base for auth redirect URIs. Must match the public URL that users
# reach through Cloudflare Tunnel or another reverse proxy.
APP_BASE_URL=https://your-app.example.com

# Calendar boundary used for Today/Weekly/Monthly/Yearly dashboard and reports.
APP_TIME_ZONE=America/Winnipeg

# --- Google OAuth ---
# Set GOOGLE_OAUTH_ENABLED=true and fill in credentials to enable Google sign-in.
# Register the redirect URI in Google Cloud Console -> APIs & Services -> Credentials.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.example.com/api/auth/oauth/google/callback

# --- Microsoft OAuth ---
# Set MICROSOFT_OAUTH_ENABLED=true and fill in credentials to enable Microsoft sign-in.
# Register the redirect URI in Azure / Entra ID -> App registrations -> Authentication.
MICROSOFT_OAUTH_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://your-app.example.com/api/auth/oauth/microsoft/callback

# --- Seed script ---
# Only needed when running: npx tsx prisma/seed.ts
# Do NOT include in the long-running app container.
# SEED_USER_PASSWORD=CHANGE_ME_seed_password
