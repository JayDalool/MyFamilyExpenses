# Copy to .env.test and point it at a DISPOSABLE local Postgres database.
#   cp .env.test.example .env.test
# .env.test is gitignored. Never point it at a real, dev, or prod database.
#
# DATABASE_URL and TEST_DATABASE_URL MUST be byte-for-byte identical, including
# the `?schema=public` suffix — the safety guard (tests/helpers/test-database.ts)
# refuses to run DB-backed tests otherwise. The database name must clearly name a
# test database (e.g. ends in `_test`); production-looking names are rejected.
#
# Credentials below are placeholders. Use throwaway local credentials only.
DATABASE_URL="postgresql://test_user:test_password@localhost:5432/myfamilyexpenses_test?schema=public"
TEST_DATABASE_URL="postgresql://test_user:test_password@localhost:5432/myfamilyexpenses_test?schema=public"
