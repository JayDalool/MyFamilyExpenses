generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Kept for potential future platform-level superadmin. Not used for data-access decisions.
enum UserRole {
  ADMIN
  USER
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum CategoryStatus {
  ACTIVE
  DISABLED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  imageUrl        String?   @map("image_url")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions            Session[]
  expenses            Expense[]
  paidExpenses        Expense[]     @relation("ExpensePaidBy")
  deletedExpenses     Expense[]     @relation("ExpenseDeletedBy")
  memberships         Membership[]
  authAccounts        AuthAccount[]
  auditLogs           AuditLog[]
  createdInvites      HouseholdInvite[]    @relation("HouseholdInviteCreatedBy")
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  expenses    Expense[]
  categories  Category[]
  auditLogs   AuditLog[]
  invites     HouseholdInvite[]

  @@map("households")
}

model Membership {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  householdId String        @map("household_id") @db.Uuid
  role        HouseholdRole @default(MEMBER)
  removedAt   DateTime?     @map("removed_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  household           Household                   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  expenses           Expense[]                   @relation("ExpenseMembership")
  paidExpenses       Expense[]                   @relation("ExpensePaidByMembership")
  extractionAttempts ReceiptExtractionAttempt[]  @relation("AttemptMembership")
  correctionFeedback ReceiptCorrectionFeedback[] @relation("FeedbackMembership")

  @@unique([userId, householdId])
  @@index([householdId])
  @@index([householdId, removedAt])
  @@index([userId])
  @@map("memberships")
}

model HouseholdInvite {
  id              String        @id @default(uuid()) @db.Uuid
  householdId     String        @map("household_id") @db.Uuid
  tokenHash       String        @unique @map("token_hash")
  email           String?
  role            HouseholdRole
  maxUses         Int           @default(1) @map("max_uses")
  usedCount       Int           @default(0) @map("used_count")
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdByUser User      @relation("HouseholdInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([householdId, expiresAt])
  @@index([householdId, revokedAt])
  @@index([createdByUserId])
  @@index([email])
  @@map("household_invites")
}

model InviteRateLimitAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  keyHash   String   @map("key_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([action, keyHash, createdAt])
  @@index([createdAt])
  @@map("invite_rate_limit_attempts")
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  householdId String         @map("household_id") @db.Uuid
  name        String
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@unique([id, householdId]) // enables compound FK from Expense for tenant integrity
  @@unique([householdId, name])
  @@index([householdId])
  @@map("categories")
}

model Expense {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  paidByUserId    String    @map("paid_by_user_id") @db.Uuid
  householdId     String    @map("household_id") @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  invoiceNumber   String    @map("invoice_number")
  invoiceDate     DateTime  @map("invoice_date") @db.Date
  amount          Decimal   @db.Decimal(12, 2)
  filePath        String    @map("file_path")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // user_id = who entered/uploaded the expense (audit owner).
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // paid_by_user_id = the assigned household member the spending is attributed to.
  paidByUser    User       @relation("ExpensePaidBy", fields: [paidByUserId], references: [id], onDelete: Restrict)
  deletedByUser User?      @relation("ExpenseDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  household     Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  // Compound FK: ensures category belongs to the same household as this expense
  category      Category   @relation(fields: [categoryId, householdId], references: [id, householdId], onDelete: Restrict)
  // Composite FK: ensures the expense owner (entered-by) is a member of the same household.
  membership    Membership @relation("ExpenseMembership", fields: [userId, householdId], references: [userId, householdId], onDelete: Restrict)
  // Composite FK: ensures the paid-by member belongs to the same household.
  paidByMembership Membership @relation("ExpensePaidByMembership", fields: [paidByUserId, householdId], references: [userId, householdId], onDelete: Restrict)
  // The OCR extraction attempt this expense was created from (single-use link).
  extractionAttempt ReceiptExtractionAttempt? @relation("ExpenseAttempt")
  // Durable predicted-vs-final correction feedback (Phase C learning signal).
  correctionFeedback ReceiptCorrectionFeedback? @relation("ExpenseFeedback")

  @@index([householdId, invoiceDate])
  @@index([householdId, deletedAt, invoiceDate])
  @@index([userId, invoiceDate])
  @@index([householdId, paidByUserId])
  @@index([categoryId, invoiceDate])
  @@map("expenses")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  householdId String?  @map("household_id") @db.Uuid
  action      String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  household Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([householdId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// Short-lived, trusted, server-side record of what OCR/the parser saw for an
// upload, captured BEFORE the user edits anything. Tenant-scoped via a composite
// FK to Membership and single-use (consumedAt / consumedByExpenseId). Raw text
// and blocks are redacted of card/account numbers before storage. Phase B
// foundation for later correction-feedback learning.
model ReceiptExtractionAttempt {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  householdId         String    @map("household_id") @db.Uuid
  fileSha256          String    @map("file_sha256")
  provider            String
  strategy            String
  providersUsed       Json      @map("providers_used")
  modelVersions       Json      @map("model_versions")
  parserVersion       String    @map("parser_version")
  rawText             String?   @map("raw_text")
  blocks              Json?
  candidates          Json
  selectedExtraction  Json      @map("selected_extraction")
  warnings            Json
  receiptType         String    @map("receipt_type")
  merchantGuess       String?   @map("merchant_guess")
  imageQuality        Json      @map("image_quality")
  confidence          Json
  durationMs          Int       @map("duration_ms")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(6)
  consumedByExpenseId String?   @unique @map("consumed_by_expense_id") @db.Uuid

  // Tenant integrity: an attempt can only ever belong to a real member of the
  // household (mirrors the expense/category composite tenant FKs).
  membership Membership @relation("AttemptMembership", fields: [userId, householdId], references: [userId, householdId], onDelete: Cascade)
  // The expense that consumed this attempt (nullable, unique).
  consumedByExpense Expense? @relation("ExpenseAttempt", fields: [consumedByExpenseId], references: [id], onDelete: SetNull)
  // Durable correction feedback derived from this attempt. The attempt itself is
  // short-lived and gets purged by cleanup (consumed/expired); feedback survives
  // because it copies everything it needs at write time and the FK is SetNull.
  correctionFeedback ReceiptCorrectionFeedback? @relation("AttemptFeedback")

  @@index([householdId, createdAt])
  @@index([expiresAt])
  @@map("receipt_extraction_attempts")
}

// Durable, tenant-scoped record comparing what OCR/the parser predicted against
// the values the user actually saved. Written best-effort AFTER a successful
// expense save that consumed a ReceiptExtractionAttempt. It deliberately stores
// only DERIVED data (predicted/final values, confidence, value-free candidate
// summary) — never raw OCR text, blocks, or file bytes. This is the learning
// corpus foundation (Phase D vendor templates); it does not change parser rules.
model ReceiptCorrectionFeedback {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  householdId   String  @map("household_id") @db.Uuid
  expenseId     String  @unique @map("expense_id") @db.Uuid
  // Nullable + SetNull: the source attempt is short-lived and gets purged, but the
  // feedback must outlive it (durable corpus). Everything needed is copied below.
  attemptId     String? @unique @map("attempt_id") @db.Uuid
  receiptType   String  @map("receipt_type")
  // Already redacted at attempt-creation time (copied from attempt.merchantGuess).
  merchantGuess String? @map("merchant_guess")
  parserVersion String  @map("parser_version")
  provider      String
  strategy      String
  providersUsed Json    @map("providers_used")
  categoryId    String? @map("category_id") @db.Uuid
  paidByUserId  String? @map("paid_by_user_id") @db.Uuid

  predictedInvoiceNumber  String?  @map("predicted_invoice_number")
  finalInvoiceNumber      String?  @map("final_invoice_number")
  invoiceNumberChanged    Boolean  @map("invoice_number_changed")
  invoiceNumberConfidence Float?   @map("invoice_number_confidence")

  predictedInvoiceDate  String?  @map("predicted_invoice_date")
  finalInvoiceDate      String?  @map("final_invoice_date")
  invoiceDateChanged    Boolean  @map("invoice_date_changed")
  invoiceDateConfidence Float?   @map("invoice_date_confidence")

  predictedAmount  Decimal? @map("predicted_amount") @db.Decimal(12, 2)
  finalAmount      Decimal  @map("final_amount") @db.Decimal(12, 2)
  amountChanged    Boolean  @map("amount_changed")
  amountConfidence Float?   @map("amount_confidence")

  predictedMerchant String?  @map("predicted_merchant")
  finalMerchant     String?  @map("final_merchant")
  merchantChanged   Boolean? @map("merchant_changed")

  warnings          Json
  candidatesSummary Json     @map("candidates_summary")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Tenant integrity: feedback can only belong to a real member of the household
  // (mirrors the attempt/expense/category composite tenant FKs).
  membership Membership @relation("FeedbackMembership", fields: [userId, householdId], references: [userId, householdId], onDelete: Cascade)
  // Source attempt (nullable; SetNull so attempt cleanup never deletes feedback).
  attempt    ReceiptExtractionAttempt? @relation("AttemptFeedback", fields: [attemptId], references: [id], onDelete: SetNull)
  // The saved expense this feedback describes (one-to-one).
  expense    Expense @relation("ExpenseFeedback", fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
  @@index([merchantGuess])
  @@map("receipt_correction_feedback")
}

enum AuthProvider {
  GOOGLE
  MICROSOFT
}

model AuthAccount {
  id                String       @id @default(cuid())
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  providerEmail     String       @map("provider_email")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([providerEmail])
  @@map("auth_accounts")
}

model PendingSignup {
  id                    String   @id @default(uuid()) @db.Uuid
  email                 String   @unique
  name                  String
  passwordHash          String   @map("password_hash")
  verificationTokenHash String   @unique @map("verification_token_hash")
  inviteTokenHash       String?  @map("invite_token_hash")
  expiresAt             DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("pending_signups")
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String?
  ip        String?
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model PasswordResetToken {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  tokenHash              String    @unique @map("token_hash")
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt                 DateTime? @map("used_at") @db.Timestamptz(6)
  requestedIpHash        String?   @map("requested_ip_hash")
  requestedUserAgentHash String?   @map("requested_user_agent_hash")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model PasswordResetRateLimitAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  keyHash   String   @map("key_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([action, keyHash, createdAt])
  @@index([createdAt])
  @@map("password_reset_rate_limit_attempts")
}
