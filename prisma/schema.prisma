generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Kept for potential future platform-level superadmin. Not used for data-access decisions.
enum UserRole {
  ADMIN
  USER
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum CategoryStatus {
  ACTIVE
  DISABLED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  imageUrl        String?   @map("image_url")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions            Session[]
  expenses            Expense[]
  deletedExpenses     Expense[]     @relation("ExpenseDeletedBy")
  memberships         Membership[]
  authAccounts        AuthAccount[]
  auditLogs           AuditLog[]
  createdInvites      HouseholdInvite[]    @relation("HouseholdInviteCreatedBy")
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  expenses    Expense[]
  categories  Category[]
  auditLogs   AuditLog[]
  invites     HouseholdInvite[]

  @@map("households")
}

model Membership {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  householdId String        @map("household_id") @db.Uuid
  role        HouseholdRole @default(MEMBER)
  removedAt   DateTime?     @map("removed_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  expenses  Expense[] @relation("ExpenseMembership")

  @@unique([userId, householdId])
  @@index([householdId])
  @@index([householdId, removedAt])
  @@index([userId])
  @@map("memberships")
}

model HouseholdInvite {
  id              String        @id @default(uuid()) @db.Uuid
  householdId     String        @map("household_id") @db.Uuid
  tokenHash       String        @unique @map("token_hash")
  email           String?
  role            HouseholdRole
  maxUses         Int           @default(1) @map("max_uses")
  usedCount       Int           @default(0) @map("used_count")
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdByUser User      @relation("HouseholdInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([householdId, expiresAt])
  @@index([householdId, revokedAt])
  @@index([createdByUserId])
  @@index([email])
  @@map("household_invites")
}

model InviteRateLimitAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  keyHash   String   @map("key_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([action, keyHash, createdAt])
  @@index([createdAt])
  @@map("invite_rate_limit_attempts")
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  householdId String         @map("household_id") @db.Uuid
  name        String
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@unique([id, householdId]) // enables compound FK from Expense for tenant integrity
  @@unique([householdId, name])
  @@index([householdId])
  @@map("categories")
}

model Expense {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  householdId     String    @map("household_id") @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  invoiceNumber   String    @map("invoice_number")
  invoiceDate     DateTime  @map("invoice_date") @db.Date
  amount          Decimal   @db.Decimal(12, 2)
  filePath        String    @map("file_path")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedByUser User?      @relation("ExpenseDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  household     Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  // Compound FK: ensures category belongs to the same household as this expense
  category      Category   @relation(fields: [categoryId, householdId], references: [id, householdId], onDelete: Restrict)
  // Composite FK: ensures the expense owner is a member of the same household.
  membership    Membership @relation("ExpenseMembership", fields: [userId, householdId], references: [userId, householdId], onDelete: Restrict)

  @@index([householdId, invoiceDate])
  @@index([householdId, deletedAt, invoiceDate])
  @@index([userId, invoiceDate])
  @@index([categoryId, invoiceDate])
  @@map("expenses")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  householdId String?  @map("household_id") @db.Uuid
  action      String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  household Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([householdId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

enum AuthProvider {
  GOOGLE
  MICROSOFT
}

model AuthAccount {
  id                String       @id @default(cuid())
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  providerEmail     String       @map("provider_email")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([providerEmail])
  @@map("auth_accounts")
}

model PendingSignup {
  id                    String   @id @default(uuid()) @db.Uuid
  email                 String   @unique
  name                  String
  passwordHash          String   @map("password_hash")
  verificationTokenHash String   @unique @map("verification_token_hash")
  inviteTokenHash       String?  @map("invite_token_hash")
  expiresAt             DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("pending_signups")
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String?
  ip        String?
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model PasswordResetToken {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  tokenHash              String    @unique @map("token_hash")
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt                 DateTime? @map("used_at") @db.Timestamptz(6)
  requestedIpHash        String?   @map("requested_ip_hash")
  requestedUserAgentHash String?   @map("requested_user_agent_hash")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model PasswordResetRateLimitAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  keyHash   String   @map("key_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([action, keyHash, createdAt])
  @@index([createdAt])
  @@map("password_reset_rate_limit_attempts")
}
